{
    "name": "sourcerer-generator",
    "displayName": "Sourcerer Generator",
    "description": "Помошник в реализации приложений на базе FrameWorkBDAndGUI",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.80.0"
    },
    "main": "./extension.js",
    "activationEvents": [],
    "contributes": {
        "submenus": [
            {
                "id": "sourcerer.submenu",
                "label": "Sourcerer"
            }
        ],
        "commands": [
            {
                "command": "sourcerer.generateSours",
                "title": "Генератор исходников"
            },
            {
                "command": "sourcerer.anotherCommand",
                "title": "Другая команда"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "submenu": "sourcerer.submenu",
                    "group": "navigation",
                    "when": "resourcePath =~ /module/"
                }
            ],
            "sourcerer.submenu": [
                {
                    "command": "sourcerer.generateSours",
                    "when": "resourcePath =~ /module/",
                    "group": "1_main@1"
                },
                {
                    "command": "sourcerer.anotherCommand",
                    "when": "resourcePath =~ /module/",
                    "group": "1_main@2"
                }
            ]
        }
    }
}