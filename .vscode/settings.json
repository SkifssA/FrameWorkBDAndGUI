{
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "python.defaultInterpreterPath": ".\/python/python.exe",
    "json.schemas": [
        {
            "fileMatch": [
                "*.odb.json"
            ],
            "url": "./core/templateJson/jsonObjectDataBase.json"
        },
        {
            "fileMatch": [
                "hooks.json"
            ],
            "url": "./core/templateJson/jsonHooks.json"
        }
    ],
    "json.validate.enable": true,
    "editor.formatOnSave": true,
    "python.REPL.enableREPLSmartSend": false
}