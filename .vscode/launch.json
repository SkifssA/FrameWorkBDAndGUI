    "version": "0.2.0",
    "configurations": [
        {
            "name": "Создание модуля",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [
                "createModule"
            ]
        },
        {
            "name": "Генератор исходников",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [
                "createSours"
            ]
        },
        {
            "name": "Генератор таблиц",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [
                "createClass"
            ]
        },
        {
            "name": "Запуск сервера",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [
                "launchServer"
            ]
        }
    ]
}