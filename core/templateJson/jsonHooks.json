{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": {
        "type": "object",
        "properties": {
            "name": {
                "type": "string",
                "description": "Путь до хука типа: {Обьект}.{Метод}"
            },
            "isClassMethod": {
                "type": "boolean",
                "description": "Являеться ли метод классовым"
            }
        },
        "required": [
            "name",
            "isClassMethod"
        ],
        "additionalProperties": false
    }
}